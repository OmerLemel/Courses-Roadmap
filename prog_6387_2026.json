 ההשלמה בהתאם לתחום ההתמחות.<br /><br />&nbsp;</p><p dir=\"rtl\">&nbsp;</p>", "sugshaot": "01", "teurshaot": "ש\"ס", "showmaarechet": "1", "pail": "1", "rama": [{"ramaid": "1", "teurrama": "שנה א'", "ramanum": "30", "avid": "", "zitut_tochnit": "", "zitut_siduri": "", "meshulevet_tochnit": "", "meshulevet_siduri": "", "tavnit": "51", "hesber": "", "shaot": "סה\"כ 56 ש\"ס", "mishkal": "סה\"כ 55 ש\"ס משוקלל", "indshaot": "1", "indmishkal": "", "indofenhoraa": "1", "indmishkalbetziun": "1", "indtziunmaavar": "0", "indmisshavuot": "0", "indshiyuch": "1", "nokursim": "", "miyun": "1", "rama": [{"ramaid": "4", "teurrama": "סמסטר א' - קורסי חובה", "ramanum": "40", "avid": "1", "zitut_tochnit": "", "zitut_siduri": "", "meshulevet_tochnit": "", "meshulevet_siduri": "", "tavnit": "51", "hesber": "", "shaot": "סה\"כ 28 ש\"ס", "mishkal": "סה\"כ 27 ש\"ס משוקלל", "indshaot": "1", "indmishkal": "", "indofenhoraa": "1", "indmishkalbetziun": "1", "indtziunmaavar": "0", "indmisshavuot": "0", "indshiyuch": "1", "nokursim": "", "miyun": "1", "kurs": [{"kursid": "03511105", "kursshow": "0351-1105", "teurkurs": "כימיה כללית 1", "kursavid": "4", "orginaltcid": "6387", "shaotuni": "7", "mishkal": "7", "tziunmaavar": "", "shiyuch": "כימיה", "ofenhoraa1": "שיעור", "shaot1": "5", "ofenhoraa2": "תרגיל", "shaot2": "2", "ofenhoraa3": "", "shaot3": "", "misgeret": "0351116", "drishotkedem": "0", "drishotmakbilot": "0", "kursindmisshavuot": "0", "anglit": "", "mevutal": "0", "shakul": "", "hidekurs": ""}, {"kursid": "03511110", "kursshow": "0351-1110", "teurkurs": "כימיה כללית 2", "kursavid": "4", "orginaltcid": "6387", "shaotuni": "5", "mishkal": "4", "tziunmaavar": "", "shiyuch": "כימיה", "ofenhoraa1": "שיעור", "shaot1": "3", "ofenhoraa2": "תרגיל", "shaot2": "2", "ofenhoraa3": "", "shaot3": "", "misgeret": "0351116", "drishotkedem": "0", "drishotmakbilot": "0", "kursindmisshavuot": "0", "anglit": "", "mevutal": "0", "shakul": "", "hidekurs": ""}, {"kursid": "03511810", "kursshow": "0351-1810", "