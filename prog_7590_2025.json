{"teurshana": "תשפ\"ו (2025-2026)", "tclongkey": "034111050105", "prev_newsletters": [{"shana": "תשפ\"ו - 2025", "url": "https://www.tau.ac.il/tochniot/pdf/2025/heb/034111050105.pdf"}, {"shana": "תשפ\"ה - 2024", "url": "https://www.tau.ac.il/tochniot/pdf/2024/heb/034111050105.pdf"}, {"shana": "תשפ\"ד - 2023", "url": "https://www.tau.ac.il/tochniot/pdf/2023/heb/034111050105.pdf"}, {"shana": "תשפ\"ג - 2022", "url": "https://www.tau.ac.il/tochniot/pdf/2022/heb/034111050105.pdf"}, {"shana": "תשפ\"ב - 2021", "url": "https://exact-sciences.tau.ac.il/yedion/2021-22"}, {"shana": "תשפ\"א - 2020", "url": "https://exact-sciences.tau.ac.il/yedion/2020-21"}, {"shana": "תש\"פ - 2019", "url": "https://exact-sciences.tau.ac.il/yedion/2019-20"}, {"shana": "תשע\"ט - 2018", "url": "https://exact-sciences.tau.ac.il/yedion/2018-19"}, {"shana": "תשע\"ח - 2017", "url": "https://exact-sciences.tau.ac.il/yedion/2017-18"}, {"shana": "תשע\"ז - 2016", "url": "https://exact-sciences.tau.ac.il/yedion/2016-17"}], "terms": [{"Title": "הנחיות ונהלים החוג לגאופיזיקה - תואר ראשון", "url": "https://exact-sciences.tau.ac.il/yedion_regulations_geophysics_bsc"}, {"Title": "תקנון הפקולטה למדעים מדויקים", "url": "https://exactsci-cms.tau.ac.il/sites/exactsci.tau.ac.il/files/media_server/Exact_Science/yedion/faculty_regulations.pdf"}], "teurtochnit": "תוכנית דו-חוגית במדעי כדור הארץ ובחוג נוסף", "teurtoar": "B.Sc. במדעי כדור הארץ ובחוג נוסף", "disclaimerletoar": "", "hesbernosaf": "התוכנית מיועדת להקנות לסטודנטיות ולסטודנטים ידע בסיסי בתחומי גאופיזיקה וגאולוגיה, מדעי האטמוספירה (אקלים ואוקיינוס), מדעים פלנטריים (מדעי החלל) וגאואינפורמטיקה, אוויר, מים וסביבה תוך הדגשת היישומים הנרחבים של תחומים אלה, בנוסף ללימודים בחוג מפקולטה אחרת בה מתקיימת תוכנית דו-חוגית.&nbsp;ציוני הקורסים ישוקללו בכל חוג בנפרד ויינתנו שני ציוני גמר.<br />תוכנית הלימודים כוללת קורסים בסיסיים במתמטיקה ובפיזיקה.<br />סטודנטיות וסטודנטים&nbsp;שיסיימו לימודים בתוכנית זו וירצו להמשיך לתואר &quot;מוסמך אוניברסיטה&quot; יוכלו לבחור בכל אחד משני החוגים של התואר &quot;בוגר אוניברסיטה&quot;, אך ייתכן שיחויבו בלימודי השלמה, בהתאם למסלול הלימודים שבו יבחרו ל&quot;תואר מוסמך&quot;.<br />&nbsp;<br /><strong><u>הערות:</u></strong><br />הקורס&nbsp;&#39;מעבדת שדה בגאולוגיה&#39; (קמפוס)&nbsp;0341-2000 יתקיים במסגרת סיור מרוכז בשבוע שלפני תחילת שנת הלימודים של שנה ב&#39;.&nbsp;הקורס&nbsp;מיועד לסטודנטים ולסטודנטיות בחוג לגאופיזיקה בלבד שהשלימו בהצלחה את הקורסים &quot;מבוא למדעי כדור הארץ&quot; ו&quot;מבנים גאולוגיים&quot;. יש להירשם אליו בסוף הסמסטר השני של שנה א&#39; בתיאום עם מרצה הקורס.", "sugshaot": "01", "teurshaot": "ש\"ס", "showmaarechet": "1", "pail": "1", "rama": [{"ramaid": "1", "teurrama": "שנה א' - קורסי חובה", "ramanum": "30", "avid": "", "zitut_tochnit": "", "zitut_siduri": "", "meshulevet_tochnit": "", "meshulevet_siduri": "", "tavnit": "51", "hesber": "", "shaot": "סה\"כ 43 ש\"ס", "mishkal": "סה\"כ 43 ש\"ס משוקלל", "indshaot": "1", "indmishkal": "", "indofenhoraa": "1", "indmishkalbetziun": "1", "indtziunmaavar": "0", "indmisshavuot": "0", "indshiyuch": "1", "nokursim": "", "miyun": "1", "rama": [{"ramaid": "9", "teurrama": "סמסטר א' -קורסי חובה", "ramanum": "40", "avid": "1", "zitut_tochnit": "", "zitut_siduri": "", "meshulevet_tochnit": "", "meshulevet_siduri": "", "tavnit": "51", "hesber": "", "shaot": "סה\"כ 21 ש\"ס", "mishkal": "סה\"כ 21 ש\"ס משוקלל", "indshaot": "1", "indmishkal": "", "indofenhoraa": "1", "indmishkalbetziun": "1", "indtziunmaavar": "0", "indmisshavuot": "0", "indshiyuch": "1", "nokursim": "", "miyun": "1", "kurs": [{"kursid": "03211100", "kursshow": "0321-1100", "teurkurs": "אלגברה לינארית לפיזיקה", "kursavid": "9", "orginaltcid": "7590", "shaotuni": "4", "mishkal": "4", "tziunmaavar": "", "shiyuch": "גאופיזיקה", "ofenhoraa1": "שיעור", "shaot1": "3", "ofenhoraa2": "תרגיל", "shaot2": "1", "ofenhoraa3": "", "shaot3": "", "misgeret": "0341107", "drishotkedem": "0", "drishotmakbilot": "0", "kursindmisshavuot": "0", "anglit": "", "mevutal": "0", "shakul": "", "hidekurs": ""}, {"kurs